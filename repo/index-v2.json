{"repo": {"name": {"en-US": "FPN Tunnel — AlienBoy69's repo"}, "description": {"en-US": "FPN Tunnel releases signed by the developer. Add this repo to your F-Droid client to install and auto-update FPN Tunnel."}, "icon": {"en-US": {"name": "/icons/icon.png", "sha256": "898c449698f517fa89869639330a389e0b82a5d47aae23b77af0d594dcb23eb1", "size": 39224}}, "address": "https://alienboy69.github.io/fdroid-repo/repo", "timestamp": 1794652445000, "categories": {"Internet": {"name": {"en-US": "Internet"}}}}, "packages": {"com.fpn.tunnel": {"metadata": {"added": 1794472570000, "categories": ["Internet"], "changelog": "https://github.com/AlienBoy69/fpn-tunnel-android/blob/main/CHANGELOG.md", "issueTracker": "https://github.com/AlienBoy69/fpn-tunnel-android/issues", "lastUpdated": 1794652445000, "license": "MIT", "sourceCode": "https://github.com/AlienBoy69/fpn-tunnel-android", "webSite": "https://github.com/AlienBoy69/fpn-tunnel-android", "authorName": "AlienBoy69", "name": {"en-US": "FPN Tunnel"}, "summary": {"en-US": "Whole-phone tunnel for your Mozilla VPN / Firefox Private Network plan"}, "description": {"en-US": "FPN Tunnel is an unofficial, open-source client that turns a Mozilla VPN /\nFirefox Private Network subscription into a whole-device Android tunnel.\n\nSign in with your own Firefox account inside the app, pick an exit country\n(or let Auto race them and pick a healthy one), and the whole phone routes\nthrough Mozilla's MASQUE proxies. Built-in connection diagnostics (\"Doctor\")\ndetect sick gateways and fail over across countries automatically.\n\n* No root, no Termux, no companion app — a single APK\n* Native in-app Firefox account sign-in (no browser needed)\n* Multiple Mozilla accounts with one-tap switching\n* Tuned for filtered networks: DNS-over-HTTPS bootstrap, CONNECT-health\n  probing, cross-country failover\n* No ads, no analytics, no third-party trackers; anonymous error reporting\n  is off unless you opt in\n\nA small number of exit countries currently work without a subscription;\nthe full country set requires a paid Mozilla VPN / Firefox Private Network\nsubscription. Not affiliated with Mozilla.\n\nNote: builds from this repo are signed with the developer's key — the same\nkey as the GitHub release APKs, so updates work across both. They are NOT\ninterchangeable with the future official F-Droid build (signed by F-Droid)."}, "icon": {"en-US": {"name": "/icons/com.fpn.tunnel.24.png", "sha256": "2dd550f1c9a6ec9239d7ed6a8e96dca50d4a8c672ae174b0a3156b0e53a25efd", "size": 1839}}, "preferredSigner": "3063c7f9d02e8aefd0057e4ce45f5ce0f2038a4f5479b910daa8fceb1692c2ac"}, "versions": {"d320ad6b16d9cf616879444c14230c345a7fd5e7cd366bd305661983aececa43": {"added": 1794652445000, "file": {"name": "/FpnTunnel-v4.5.1.apk", "sha256": "d320ad6b16d9cf616879444c14230c345a7fd5e7cd366bd305661983aececa43", "size": 1146184}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a"], "versionName": "4.5.1", "versionCode": 24, "usesSdk": {"minSdkVersion": 25, "targetSdkVersion": 34}, "signer": {"sha256": ["3063c7f9d02e8aefd0057e4ce45f5ce0f2038a4f5479b910daa8fceb1692c2ac"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.QUERY_ALL_PACKAGES"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_SPECIAL_USE"}, {"name": "android.permission.REQUEST_INSTALL_PACKAGES"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.USE_BIOMETRIC"}]}, "antiFeatures": {"NonFreeNet": {}}}, "2903b9214094da39f3b2917c4b885d4b0e293ad77b8cdff6289883136087c6a2": {"added": 1794484141000, "file": {"name": "/FpnTunnel-v4.4.1.apk", "sha256": "2903b9214094da39f3b2917c4b885d4b0e293ad77b8cdff6289883136087c6a2", "size": 1137992}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a"], "versionName": "4.4.1", "versionCode": 22, "usesSdk": {"minSdkVersion": 25, "targetSdkVersion": 34}, "signer": {"sha256": ["3063c7f9d02e8aefd0057e4ce45f5ce0f2038a4f5479b9